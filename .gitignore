# local design scope / spec (internal, not shipped)
/CLAUDE.md

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# yt-vault: generated transcript notes are user data (keep the folder, not the contents)
library/*.md
library/INDEX.md
!library/.gitkeep

# logs / OS
*.log
.DS_Store
Thumbs.db

# media: ship curated CC0 defaults, ignore everything else users drop in
web/rooms/*
!web/rooms/.gitkeep
!web/rooms/library.jpg
!web/rooms/cafe.jpg
!web/rooms/rain.jpg
!web/rooms/lofi.jpg
!web/rooms/garden.jpg
!web/rooms/dusk.jpg
!web/rooms/paper.jpg
web/assets/orb.*
!web/assets/orb.webp
