# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# yt-vault: generated transcript notes are user data (keep the folder, not the contents)
library/*.md
library/INDEX.md
!library/.gitkeep

# logs / OS
*.log
.DS_Store
Thumbs.db

# user-supplied media (keep folders, not contents)
web/rooms/*
!web/rooms/.gitkeep
web/assets/orb.*
